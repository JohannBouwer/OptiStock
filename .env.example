# Template for the ingest agents' configuration. Copy it, then edit your copy:
#
#   cp .env.example .env
#   optistock-ingest --check
#
# `.env` is gitignored; this file is not, so never put a real key here.
# Only `optistock.ingest` reads any of this — the core library needs none of it.
# Everything below is optional: with no .env at all the defaults point at a local
# Ollama running gemma3:4b.

# ---------------------------------------------------------------------------
# Endpoint — any OpenAI-compatible /v1 URL
# ---------------------------------------------------------------------------
# Four shorthands are recognised, or give a full URL for anything else
# (vLLM, llama.cpp, a company gateway):
#
#   ollama      http://localhost:11434/v1
#   lmstudio    http://localhost:1234/v1
#   openrouter  https://openrouter.ai/api/v1
#   google      https://generativelanguage.googleapis.com/v1beta/openai/
#
INGEST_BASE_URL=openrouter

# Local servers accept any non-empty value; the default placeholder is "not-needed".
# For OpenRouter, get one at https://openrouter.ai/keys
INGEST_API_KEY=replace-me

# ---------------------------------------------------------------------------
# One model per agent
# ---------------------------------------------------------------------------
# All three share the endpoint and key above, so by default they pick different
# models on the *same* provider. To cross providers, build the model in Python and
# pass it in: ingest(df, review_model=build_model("m", base_url="https://other/v1")).
#
# The two optional slots fall back to INGEST_MODEL when unset OR empty, so a line
# left as `INGEST_REVIEW_MODEL=` is a fallback, not an empty model name.
#
#   1 describe  120 words of prose that nothing downstream parses. The cheapest
#               model you have is fine here; a stronger one buys nothing.
#   2 map       Where every wrong number comes from. Spend here. A mid-tier mapper
#               handles easy sources identically to a frontier one, then collapses
#               an integer day counter into 1970 and reports it as valid.
#   3 review    Judges the RESULT, which agent 2 never sees. Point it at a
#               different vendor than the mapper — a reviewer from the same lineage
#               inherits the blind spots that produced the mapping. Cheaper is fine.
#
# The values below are examples, not requirements. Substitute whatever your
# endpoint serves; only the names change.
INGEST_DESCRIBE_MODEL=qwen/qwen3.7-flash
INGEST_MODEL=anthropic/claude-sonnet-5
INGEST_REVIEW_MODEL=z-ai/glm-5.2

# ---------------------------------------------------------------------------
# Structured output mode: native | tool | prompted
# ---------------------------------------------------------------------------
# native    provider-side JSON-schema constrained decoding. The default, because
#           models without tool tokens (Gemma) cannot do `tool` reliably.
#           On OpenRouter, check the model advertises `structured_outputs` —
#           `response_format` alone is not enough.
# tool      function calling. Needs real tool support; fails on Gemini via OpenRouter.
# prompted  schema described in the prompt and parsed back. The weakest of the
#           three — nothing is enforced during sampling. Use it only for models
#           that support neither of the above.
INGEST_OUTPUT_MODE=native

# ---------------------------------------------------------------------------
# Other setups — uncomment one block, comment out the OpenRouter lines above
# ---------------------------------------------------------------------------
# Local Ollama, no key required:
# INGEST_MODEL=gemma3:4b
# INGEST_BASE_URL=ollama
#
# Google AI Studio:
# INGEST_MODEL=gemma-3-4b-it
# INGEST_BASE_URL=google
# INGEST_API_KEY=replace-me
